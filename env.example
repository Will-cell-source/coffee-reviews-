# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI — platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-5.6 if unset. Change here if the model name moves.
OPENAI_MODEL=

# Make.com — the webhook URL from your scenario's Custom Webhook module
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/xxxxxxxx

# Any random string. Vercel sends this as a Bearer token on cron runs.
CRON_SECRET=

# Used only by `npm run qr`
SITE_URL=https://taste.yourroastery.co
